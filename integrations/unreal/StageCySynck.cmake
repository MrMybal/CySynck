cmake_minimum_required(VERSION 3.24)
# Stage a new plugin from a complete installed SDK. Never overwrite an existing
# project plugin, its native libraries, build outputs or user modifications.
if(NOT DEFINED CYSYNCK_PREFIX OR NOT IS_ABSOLUTE "${CYSYNCK_PREFIX}" OR
   NOT DEFINED UNREAL_PLUGIN_DIR OR NOT IS_ABSOLUTE "${UNREAL_PLUGIN_DIR}")
  message(FATAL_ERROR "Pass absolute CYSYNCK_PREFIX and a new absolute UNREAL_PLUGIN_DIR")
endif()
if(EXISTS "${UNREAL_PLUGIN_DIR}" OR IS_SYMLINK "${UNREAL_PLUGIN_DIR}")
  message(FATAL_ERROR "UNREAL_PLUGIN_DIR already exists; preserve it and choose a new destination")
endif()
foreach(required IN ITEMS share/cysynck/version.json include/cysynck/c_api.h share/cysynck/LICENSE share/cysynck/THIRD_PARTY.md)
  if(NOT EXISTS "${CYSYNCK_PREFIX}/${required}")
    message(FATAL_ERROR "Incomplete installed SDK: missing ${required}")
  endif()
endforeach()
set(native_library "")
foreach(candidate IN ITEMS bin/cysynck_core.dll lib/libcysynck_core.so lib/libcysynck_core.dylib)
  if(EXISTS "${CYSYNCK_PREFIX}/${candidate}")
    if(NOT native_library STREQUAL "")
      message(FATAL_ERROR "SDK contains multiple target platforms; select a single package")
    endif()
    set(native_library "${candidate}")
  endif()
endforeach()
if(native_library STREQUAL "")
  message(FATAL_ERROR "Installed SDK has no native CySynck shared library")
endif()
file(READ "${CYSYNCK_PREFIX}/share/cysynck/version.json" manifest)
string(JSON version GET "${manifest}" version)
set(source "${CMAKE_CURRENT_LIST_DIR}/CySynck")
if(NOT EXISTS "${source}/CySynck.uplugin")
  message(FATAL_ERROR "The Unreal plugin source must accompany StageCySynck.cmake")
endif()
file(MAKE_DIRECTORY "${UNREAL_PLUGIN_DIR}")
file(COPY "${source}/" DESTINATION "${UNREAL_PLUGIN_DIR}"
  PATTERN Binaries EXCLUDE PATTERN Intermediate EXCLUDE PATTERN ThirdParty EXCLUDE
  PATTERN Saved EXCLUDE PATTERN .vs EXCLUDE)
set(native "${UNREAL_PLUGIN_DIR}/ThirdParty/CySynck")
get_filename_component(library_directory "${native_library}" DIRECTORY)
file(MAKE_DIRECTORY "${native}/${library_directory}")
file(COPY "${CYSYNCK_PREFIX}/${native_library}" DESTINATION "${native}/${library_directory}")
file(COPY "${CYSYNCK_PREFIX}/include/" DESTINATION "${native}/include")
file(COPY "${CYSYNCK_PREFIX}/share/cysynck/LICENSE" "${CYSYNCK_PREFIX}/share/cysynck/THIRD_PARTY.md" "${CYSYNCK_PREFIX}/share/cysynck/version.json"
  DESTINATION "${native}")
if(EXISTS "${CYSYNCK_PREFIX}/share/cysynck/licenses")
  file(COPY "${CYSYNCK_PREFIX}/share/cysynck/licenses" DESTINATION "${native}")
endif()
if(EXISTS "${CYSYNCK_PREFIX}/Documentation")
  file(COPY "${CYSYNCK_PREFIX}/Documentation" DESTINATION "${native}")
endif()
if(native_library MATCHES "[.]dll$")
  file(GLOB runtime "${CYSYNCK_PREFIX}/bin/msvcp*.dll" "${CYSYNCK_PREFIX}/bin/vcruntime*.dll" "${CYSYNCK_PREFIX}/bin/concrt*.dll")
  if(runtime)
    file(COPY ${runtime} DESTINATION "${native}/bin")
  endif()
endif()
message(STATUS "Staged CySynck SDK ${version} and Unreal bridge 0.2.0: ${UNREAL_PLUGIN_DIR}")
