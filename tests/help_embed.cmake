cmake_minimum_required(VERSION 3.24)
foreach(path IN ITEMS HOST_EXECUTABLE CORE_LIBRARY EXPECTED_DOCUMENTATION WORK_PARENT)
  if(NOT DEFINED ${path} OR NOT IS_ABSOLUTE "${${path}}" OR NOT EXISTS "${${path}}")
    message(FATAL_ERROR "Pass an existing absolute ${path}")
  endif()
endforeach()
string(RANDOM LENGTH 16 ALPHABET 0123456789abcdef nonce)
set(work "${WORK_PARENT}/embedded-help-${nonce}")
if(EXISTS "${work}" OR IS_SYMLINK "${work}")
  message(FATAL_ERROR "Preserve the existing embedding fixture")
endif()
file(MAKE_DIRECTORY "${work}")
file(COPY "${HOST_EXECUTABLE}" DESTINATION "${work}")
get_filename_component(name "${HOST_EXECUTABLE}" NAME)
get_filename_component(core_bin "${CORE_LIBRARY}" DIRECTORY)
if(WIN32)
  set(ENV{PATH} "${core_bin};$ENV{PATH}")
endif()
execute_process(COMMAND "${CMAKE_COMMAND}" -E env --unset=CYSYNCK_DOC_ROOT
  "${work}/${name}" "${work}/profil été" POST /api/help/location
  "{\"page\":\"network\",\"section\":\"automatic-endpoints\",\"language\":\"fr\"}"
  WORKING_DIRECTORY "${work}" RESULT_VARIABLE result OUTPUT_VARIABLE output ERROR_VARIABLE error)
if(NOT result EQUAL 0)
  message(FATAL_ERROR "Relocated pure C host could not resolve the library's manual: ${error}")
endif()
string(JSON path GET "${output}" path)
string(JSON url GET "${output}" url)
file(REAL_PATH "${path}" actual)
file(REAL_PATH "${EXPECTED_DOCUMENTATION}/Documentation.html" expected)
if(NOT actual STREQUAL expected OR NOT url MATCHES "^file:///.+Documentation[.]html#/fr/network/automatic-endpoints$")
  message(FATAL_ERROR "Embedded help did not preserve the module path, language and stable section: ${output}")
endif()
cmake_path(IS_PREFIX WORK_PARENT "${work}" NORMALIZE owned)
if(NOT owned OR IS_SYMLINK "${work}")
  message(FATAL_ERROR "Refuse foreign embedding-fixture cleanup")
endif()
file(REMOVE_RECURSE "${work}")
message(STATUS "PASS pure C host relocated without its own manual or environment override")
