else()
  set(suffix "")
endif()
function(run_response executable output_variable)
  execute_process(COMMAND "${executable}" ${ARGN} WORKING_DIRECTORY "${WORK_DIR}"
    RESULT_VARIABLE result OUTPUT_VARIABLE output ERROR_VARIABLE error ENCODING UTF-8 TIMEOUT 30)
  if(NOT result EQUAL 0)
    message(FATAL_ERROR "Packaged executable failed (${result}): ${error}")
  endif()
  string(JSON output_type TYPE "${output}")
  set(${output_variable} "${output}" PARENT_SCOPE)
endfunction()
function(run_json executable output_variable)
  run_response("${executable}" output ${ARGN})
  string(JSON actual_version GET "${output}" version)
  if(NOT actual_version STREQUAL expected_version)
    message(FATAL_ERROR "Packaged executable version differs from its manifest")
  endif()
  set(${output_variable} "${output}" PARENT_SCOPE)
endfunction()
