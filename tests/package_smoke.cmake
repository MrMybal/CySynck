endif()
if(EXISTS "${WORK_DIR}" OR NOT IS_ABSOLUTE "${WORK_DIR}")
  message(FATAL_ERROR "WORK_DIR must be an absolute path that does not exist yet")
endif()
list(GET archives 0 archive)
