cmake_minimum_required(VERSION 3.24)
# Run on the target OS, against a newly generated archive, never a live installation.
if(NOT DEFINED PACKAGE_DIR OR NOT DEFINED WORK_DIR)
  message(FATAL_ERROR "Pass absolute PACKAGE_DIR and a new WORK_DIR")
endif()
file(GLOB archives "${PACKAGE_DIR}/CySynck-*.zip" "${PACKAGE_DIR}/CySynck-*.tar.gz")
list(LENGTH archives archive_count)
if(NOT archive_count EQUAL 1)
  message(FATAL_ERROR "Expected exactly one CySynck archive in PACKAGE_DIR")
endif()
if(EXISTS "${WORK_DIR}" OR NOT IS_ABSOLUTE "${WORK_DIR}")
  message(FATAL_ERROR "WORK_DIR must be an absolute path that does not exist yet")
endif()
list(GET archives 0 archive)
file(MAKE_DIRECTORY "${WORK_DIR}/extracted")
file(ARCHIVE_EXTRACT INPUT "${archive}" DESTINATION "${WORK_DIR}/extracted")
file(GLOB_RECURSE manifests "${WORK_DIR}/extracted/*/share/cysynck/version.json")
list(LENGTH manifests manifest_count)
if(NOT manifest_count EQUAL 1)
  message(FATAL_ERROR "Archive must contain exactly one version manifest")
endif()
list(GET manifests 0 manifest)
get_filename_component(manifest_directory "${manifest}" DIRECTORY)
get_filename_component(prefix "${manifest_directory}/../.." ABSOLUTE)
file(READ "${manifest}" version_json)
string(JSON expected_version GET "${version_json}" version)
if(CMAKE_HOST_WIN32)
  set(suffix .exe)
else()
  set(suffix "")
endif()
function(run_response executable output_variable)
  execute_process(COMMAND "${executable}" ${ARGN} WORKING_DIRECTORY "${WORK_DIR}"
    RESULT_VARIABLE result OUTPUT_VARIABLE output ERROR_VARIABLE error TIMEOUT 30)
  if(NOT result EQUAL 0)
    message(FATAL_ERROR "Packaged executable failed (${result}): ${error}")
  endif()
  string(JSON output_type TYPE "${output}")
  set(${output_variable} "${output}" PARENT_SCOPE)
endfunction()
function(run_json executable output_variable)
  run_response("${executable}" output ${ARGN})
  string(JSON actual_version GET "${output}" version)
  if(NOT actual_version STREQUAL expected_version)
    message(FATAL_ERROR "Packaged executable version differs from its manifest")
  endif()
  set(${output_variable} "${output}" PARENT_SCOPE)
endfunction()
set(cli "${prefix}/bin/cysynck${suffix}")
run_json("${cli}" overview --state "${WORK_DIR}/cli-state" overview)
foreach(required IN ITEMS share/cysynck/web/index.html share/cysynck/licenses/TinyXML2.txt
    lib/cmake/CySynck/CySynckConfig.cmake include/cysynck/core.hpp)
  if(NOT EXISTS "${prefix}/${required}")
    message(FATAL_ERROR "Archive is missing ${required}")
  endif()
endforeach()
# Build and execute an independent consumer against the extracted SDK.
execute_process(COMMAND "${CMAKE_COMMAND}" -S "${prefix}/share/cysynck/examples/consumer"
  -B "${WORK_DIR}/sdk" "-DCMAKE_PREFIX_PATH=${prefix}" -DCMAKE_BUILD_TYPE=Release
  RESULT_VARIABLE result)
if(NOT result EQUAL 0)
  message(FATAL_ERROR "Extracted SDK configuration failed")
endif()
execute_process(COMMAND "${CMAKE_COMMAND}" --build "${WORK_DIR}/sdk" --config Release
  RESULT_VARIABLE result)
if(NOT result EQUAL 0)
  message(FATAL_ERROR "Extracted SDK consumer failed to link")
endif()
set(consumer "${WORK_DIR}/sdk/cysynck-consumer${suffix}")
if(EXISTS "${WORK_DIR}/sdk/Release/cysynck-consumer${suffix}")
  set(consumer "${WORK_DIR}/sdk/Release/cysynck-consumer${suffix}")
endif()
run_json("${consumer}" sdk_overview "${WORK_DIR}/sdk-state")
# A C-only consumer checks the ABI without relying on C++ headers or language setup.
execute_process(COMMAND "${CMAKE_COMMAND}" -S "${prefix}/share/cysynck/examples/c-consumer"
  -B "${WORK_DIR}/c-sdk" "-DCMAKE_PREFIX_PATH=${prefix}" -DCMAKE_BUILD_TYPE=Release
  RESULT_VARIABLE result)
if(NOT result EQUAL 0)
  message(FATAL_ERROR "C ABI consumer configuration failed")
endif()
execute_process(COMMAND "${CMAKE_COMMAND}" --build "${WORK_DIR}/c-sdk" --config Release
  RESULT_VARIABLE result)
if(NOT result EQUAL 0)
  message(FATAL_ERROR "C ABI consumer failed to link")
endif()
set(c_consumer "${WORK_DIR}/c-sdk/cysynck-c-consumer${suffix}")
if(EXISTS "${WORK_DIR}/c-sdk/Release/cysynck-c-consumer${suffix}")
  set(c_consumer "${WORK_DIR}/c-sdk/Release/cysynck-c-consumer${suffix}")
endif()
run_json("${c_consumer}" c_overview "${WORK_DIR}/C profil été")
run_json("${c_consumer}" c_diagnostics "${WORK_DIR}/C profil été" GET /api/doctor)
file(MAKE_DIRECTORY "${WORK_DIR}/C project été")
file(TO_CMAKE_PATH "${WORK_DIR}/C project été" c_project_root)
string(REPLACE "\\" "\\\\" c_project_root "${c_project_root}")
string(REPLACE "\"" "\\\"" c_project_root "${c_project_root}")
run_response("${c_consumer}" c_project "${WORK_DIR}/C profil été" POST /api/projects
  "{\"id\":\"transfers\",\"name\":\"C ABI transfers\",\"mode\":\"backup\",\"backup_interval_minutes\":0,\"root\":\"${c_project_root}\"}")
run_response("${c_consumer}" c_transfers "${WORK_DIR}/C profil été" POST /api/network/transfers
  "{\"project\":\"transfers\"}")
string(JSON transfer_count LENGTH "${c_transfers}" files)
if(NOT transfer_count EQUAL 0)
  message(FATAL_ERROR "Fresh C ABI profile must have an empty transfer list")
endif()
run_response("${c_consumer}" c_policy "${WORK_DIR}/C profil été" PUT /api/projects/transfers
  "{\"backup_storage\":\"whole\"}")
string(JSON backup_policy GET "${c_policy}" backup_storage)
if(NOT backup_policy STREQUAL "whole")
  message(FATAL_ERROR "C ABI did not save the backup storage policy")
endif()
run_response("${c_consumer}" c_policy "${WORK_DIR}/C profil été" PUT /api/projects/transfers
  "{\"backup_storage\":\"auto\"}")
string(REPEAT "a" 4194304 sdk_block)
file(WRITE "${WORK_DIR}/C project été/large.bin" "${sdk_block}${sdk_block}")
unset(sdk_block)
run_response("${c_consumer}" c_backup "${WORK_DIR}/C profil été" POST /api/projects/transfers/backup "{}")
string(JSON block_bytes GET "${c_backup}" block_storage reused_block_bytes)
if(NOT block_bytes EQUAL 4194304)
  message(FATAL_ERROR "C ABI block backup must reuse its identical second block")
endif()
run_response("${c_consumer}" c_verify "${WORK_DIR}/C profil été" POST /api/projects/transfers/verify "{}")
string(JSON verified GET "${c_verify}" ok)
if(NOT verified)
  message(FATAL_ERROR "Packaged C ABI could not verify its block backup")
endif()
file(TO_CMAKE_PATH "${WORK_DIR}/C restored été" c_restore_root)
string(REPLACE "\\" "\\\\" c_restore_root "${c_restore_root}")
string(REPLACE "\"" "\\\"" c_restore_root "${c_restore_root}")
run_response("${c_consumer}" c_restore "${WORK_DIR}/C profil été" POST /api/projects/transfers/restore
  "{\"destination\":\"${c_restore_root}\"}")
file(SHA256 "${WORK_DIR}/C project été/large.bin" expected_digest)
file(SHA256 "${WORK_DIR}/C restored été/large.bin" restored_digest)
if(NOT expected_digest STREQUAL restored_digest)
  message(FATAL_ERROR "Packaged block restoration changed the file bytes")
endif()
run_json("${c_consumer}" c_service "${WORK_DIR}/C profil été" POST /api/service/plan
  "{\"platform\":\"linux\",\"executable\":\"/opt/cysynck/bin/cysynck\",\"target_state\":\"/srv/team\"}")
execute_process(COMMAND "${c_consumer}" "${WORK_DIR}/C profil été" GET /api/unknown
  RESULT_VARIABLE result OUTPUT_VARIABLE output ERROR_VARIABLE error)
if(NOT result EQUAL 1 OR NOT error MATCHES "error")
  message(FATAL_ERROR "C ABI errors must produce a failure status and JSON diagnostic")
endif()
if(CMAKE_HOST_APPLE AND EXISTS "${prefix}/CySynck.app")
  execute_process(COMMAND plutil -lint "${prefix}/CySynck.app/Contents/Info.plist"
    RESULT_VARIABLE result)
  if(NOT result EQUAL 0)
    message(FATAL_ERROR "Invalid macOS bundle property list")
  endif()
  execute_process(COMMAND codesign --verify --deep --strict "${prefix}/CySynck.app"
    RESULT_VARIABLE result ERROR_VARIABLE error)
  if(NOT result EQUAL 0)
    message(FATAL_ERROR "Installed bundle signature is invalid: ${error}")
  endif()
  execute_process(COMMAND "${cli}" --state "${WORK_DIR}/cli-state" desktop startup status
    RESULT_VARIABLE result OUTPUT_VARIABLE startup ERROR_VARIABLE error)
  if(NOT result EQUAL 0)
    message(FATAL_ERROR "Cannot inspect bundled startup target: ${error}")
  endif()
  string(JSON launch GET "${startup}" arguments 0)
  if(NOT launch STREQUAL "${prefix}/CySynck.app/Contents/MacOS/CySynck")
    message(FATAL_ERROR "CLI startup target does not point inside the app bundle")
  endif()
  # Moving only the app must retain its core library, resources and licenses.
  file(MAKE_DIRECTORY "${WORK_DIR}/moved")
  file(COPY "${prefix}/CySynck.app" DESTINATION "${WORK_DIR}/moved")
  file(RENAME "${WORK_DIR}/moved/CySynck.app" "${WORK_DIR}/moved/Cy Synck.app")
  set(desktop "${WORK_DIR}/moved/Cy Synck.app/Contents/MacOS/CySynck")
  foreach(required IN ITEMS Frameworks/libcysynck_core.dylib Resources/web/index.html
      Resources/licenses/CyUI.txt)
    if(NOT EXISTS "${WORK_DIR}/moved/Cy Synck.app/Contents/${required}")
      message(FATAL_ERROR "Relocated bundle is missing ${required}")
    endif()
  endforeach()
else()
  set(desktop "${prefix}/bin/cysynck-desktop${suffix}")
endif()
if(DESKTOP_SMOKE)
  execute_process(COMMAND "${desktop}" --state "${WORK_DIR}/desktop-state" --frames 8
    --capture "${WORK_DIR}/desktop.bmp" WORKING_DIRECTORY "${WORK_DIR}"
    RESULT_VARIABLE result OUTPUT_VARIABLE output ERROR_VARIABLE error TIMEOUT 60)
  if(NOT result EQUAL 0 OR NOT EXISTS "${WORK_DIR}/desktop.bmp")
    message(FATAL_ERROR "Packaged desktop failed to render (${result}): ${error}")
  endif()
endif()
message(STATUS "PASS packaged CLI, C++ SDK and C ABI ${expected_version}; fixtures: ${WORK_DIR}")
