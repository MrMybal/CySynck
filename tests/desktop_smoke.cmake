cmake_minimum_required(VERSION 3.24)
function(cysynck_desktop_smoke desktop WORK_DIR)
  if(NOT IS_ABSOLUTE "${WORK_DIR}")
    message(FATAL_ERROR "Desktop smoke WORK_DIR must be absolute")
  endif()
  file(MAKE_DIRECTORY "${WORK_DIR}")
  foreach(renderer IN ITEMS auto opengl2)
    set(capture "${WORK_DIR}/desktop-${renderer}.bmp")
    execute_process(COMMAND "${desktop}" --state "${WORK_DIR}/desktop-state" --frames 8
      --renderer "${renderer}" --language fr --capture "${capture}" WORKING_DIRECTORY "${WORK_DIR}"
      RESULT_VARIABLE result OUTPUT_VARIABLE output ERROR_VARIABLE error TIMEOUT 60)
    if(NOT result EQUAL 0 OR NOT EXISTS "${capture}")
      message(FATAL_ERROR "Packaged desktop (${renderer}) failed to render (${result}): ${output}\n${error}")
    endif()
    message(STATUS "Packaged desktop: ${output}")
    # A successful process with an empty/flat framebuffer is not a rendering pass.
    file(READ "${capture}" header LIMIT 54 HEX)
    string(SUBSTRING "${header}" 0 4 signature)
    if(NOT signature STREQUAL "424d")
      message(FATAL_ERROR "Desktop capture is not a BMP")
    endif()
    foreach(dimension IN ITEMS width height)
      if(dimension STREQUAL "width")
        set(offset 36)
      else()
        set(offset 44)
      endif()
      string(SUBSTRING "${header}" ${offset} 2 byte0)
      math(EXPR offset "${offset}+2")
      string(SUBSTRING "${header}" ${offset} 2 byte1)
      math(EXPR ${dimension} "0x${byte0} + (0x${byte1} << 8)")
      if(${dimension} LESS 100 OR ${dimension} GREATER 16384)
        message(FATAL_ERROR "Invalid desktop capture ${dimension}")
      endif()
    endforeach()
    math(EXPR stride "((${width} * 3 + 3) / 4) * 4")
    math(EXPR required_size "54 + ${stride} * ${height}")
    file(SIZE "${capture}" actual_size)
    if(NOT actual_size EQUAL required_size)
      message(FATAL_ERROR "Truncated desktop framebuffer capture")
    endif()
    set(colors "")
    foreach(y RANGE 1 16)
      foreach(x RANGE 1 16)
        math(EXPR pixel "54 + (${height} * ${y} / 17) * ${stride} + (${width} * ${x} / 17) * 3")
        file(READ "${capture}" color OFFSET ${pixel} LIMIT 3 HEX)
        list(APPEND colors "${color}")
      endforeach()
    endforeach()
    list(REMOVE_DUPLICATES colors)
    list(LENGTH colors color_count)
    if(color_count LESS 3)
      message(FATAL_ERROR "Desktop framebuffer has no visible application content")
    endif()
  endforeach()
endfunction()

if(CMAKE_SCRIPT_MODE_FILE STREQUAL CMAKE_CURRENT_LIST_FILE)
  if(NOT DEFINED DESKTOP_EXECUTABLE OR NOT DEFINED WORK_DIR)
    message(FATAL_ERROR "Pass DESKTOP_EXECUTABLE and an isolated WORK_DIR")
  endif()
  cysynck_desktop_smoke("${DESKTOP_EXECUTABLE}" "${WORK_DIR}")
endif()
