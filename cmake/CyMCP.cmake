set(CYSYNCK_CYMCP_REVISION "791d4d7d7680213b282ec8529d248a10f8494d77")
set(CYSYNCK_CYMCP_SOURCE_DIR "" CACHE PATH "CyMCPSDK sources; the sibling checkout is preferred")
if(NOT CYSYNCK_CYMCP_SOURCE_DIR AND EXISTS "${CMAKE_SOURCE_DIR}/../CyMCPSDK/CMakeLists.txt")
  get_filename_component(CYSYNCK_CYMCP_SOURCE_DIR "${CMAKE_SOURCE_DIR}/../CyMCPSDK" ABSOLUTE)
endif()
if(NOT CYSYNCK_CYMCP_SOURCE_DIR)
  FetchContent_Declare(cymcp GIT_REPOSITORY https://github.com/MrMybal/CyMCPSDK.git
    GIT_TAG ${CYSYNCK_CYMCP_REVISION} SOURCE_SUBDIR _host_adds_sdk)
  FetchContent_MakeAvailable(cymcp)
  set(CYSYNCK_CYMCP_SOURCE_DIR "${cymcp_SOURCE_DIR}")
endif()
execute_process(COMMAND git -c "safe.directory=${CYSYNCK_CYMCP_SOURCE_DIR}" -C "${CYSYNCK_CYMCP_SOURCE_DIR}" rev-parse --show-toplevel
  OUTPUT_VARIABLE CYSYNCK_CYMCP_GIT_ROOT OUTPUT_STRIP_TRAILING_WHITESPACE ERROR_QUIET)
file(REAL_PATH "${CYSYNCK_CYMCP_SOURCE_DIR}" CYSYNCK_CYMCP_REAL_SOURCE)
set(CYSYNCK_CYMCP_ACTUAL_REVISION "")
# An extracted source tree inside this repository must not inherit CySynck's SHA.
if(CYSYNCK_CYMCP_GIT_ROOT STREQUAL CYSYNCK_CYMCP_REAL_SOURCE)
  execute_process(COMMAND git -c "safe.directory=${CYSYNCK_CYMCP_SOURCE_DIR}" -C "${CYSYNCK_CYMCP_SOURCE_DIR}" rev-parse HEAD
    OUTPUT_VARIABLE CYSYNCK_CYMCP_ACTUAL_REVISION OUTPUT_STRIP_TRAILING_WHITESPACE)
endif()
if(NOT CYSYNCK_CYMCP_ACTUAL_REVISION)
  set(CYSYNCK_CYMCP_ACTUAL_REVISION "source-archive-${CYSYNCK_CYMCP_REVISION}")
endif()
set(CYMCP_BUILD_HTTP ON CACHE BOOL "" FORCE)
set(CYMCP_BUILD_PLATFORM ON CACHE BOOL "" FORCE)
set(CYMCP_BUILD_MCP ON CACHE BOOL "" FORCE)
set(CYMCP_BUILD_AI ON CACHE BOOL "" FORCE)
set(CYMCP_BUILD_LOCAL OFF CACHE BOOL "" FORCE)
set(CYMCP_BUILD_EXAMPLES OFF CACHE BOOL "" FORCE)
set(CYMCP_BUILD_TESTS OFF CACHE BOOL "" FORCE)
set(CYMCP_BUILD_CHAT_APP OFF CACHE BOOL "" FORCE)
set(CYMCP_BUILD_CHAT_UI ${CYSYNCK_DESKTOP} CACHE BOOL "" FORCE)
add_subdirectory("${CYSYNCK_CYMCP_SOURCE_DIR}" "${CMAKE_BINARY_DIR}/cymcp" EXCLUDE_FROM_ALL)
add_library(cysynck_assistant STATIC src/assistant.cpp src/assistant_actions.cpp)
target_include_directories(cysynck_assistant PUBLIC src)
target_link_libraries(cysynck_assistant PUBLIC cysynck_core CyMCP::MCP CyMCP::AI)
target_compile_definitions(cysynck_assistant PRIVATE CYSYNCK_CYMCP_REVISION="${CYSYNCK_CYMCP_ACTUAL_REVISION}")
if(MSVC)
  target_compile_options(cysynck_assistant PRIVATE /utf-8 /EHsc /W4)
endif()
target_link_libraries(cysynck PRIVATE cysynck_assistant)
if(CYSYNCK_DESKTOP)
  target_sources(cysynck-desktop PRIVATE src/assistant_ui.cpp)
  target_link_libraries(cysynck-desktop PRIVATE cysynck_assistant CyMCP::ChatUI)
endif()
set(cysynck_mcp_license_destinations share/cysynck/licenses)
if(APPLE AND CYSYNCK_DESKTOP)
  list(APPEND cysynck_mcp_license_destinations CySynck.app/Contents/Resources/licenses)
endif()
foreach(destination IN LISTS cysynck_mcp_license_destinations)
  install(FILES "${CYSYNCK_CYMCP_SOURCE_DIR}/LICENSE" DESTINATION "${destination}" RENAME CyMCPSDK-MIT.txt)
  install(FILES "${CYSYNCK_CYMCP_SOURCE_DIR}/THIRD_PARTY_NOTICES.md" DESTINATION "${destination}" RENAME CyMCPSDK-THIRD-PARTY.md)
  foreach(notice nlohmann/LICENSE.MIT httplib/LICENSE picosha2/LICENSE)
    string(REPLACE "/" "-" notice_name "${notice}")
    install(FILES "${CYSYNCK_CYMCP_SOURCE_DIR}/third_party/${notice}" DESTINATION "${destination}" RENAME "CyMCPSDK-${notice_name}")
  endforeach()
endforeach()
message(STATUS "CySynck uses source-built CyMCPSDK ${CYSYNCK_CYMCP_ACTUAL_REVISION} (Core, Platform, Http, MCP, AI; ChatUI on desktop)")
