# Cross-compile the headless C++ core and CLI without a Linux sysroot installation.
set(CMAKE_SYSTEM_NAME Linux)
set(CYSYNCK_ZIG_TARGET "x86_64-linux-gnu.2.31" CACHE STRING "Zig Linux target triple")
if(NOT CYSYNCK_ZIG_TARGET MATCHES "^(x86_64|aarch64)-linux-(gnu|musl)(\\.[0-9]+\\.[0-9]+)?$")
  message(FATAL_ERROR "Choose an x86_64 or aarch64 Linux GNU/musl target")
endif()
string(REGEX REPLACE "-.*" "" CMAKE_SYSTEM_PROCESSOR "${CYSYNCK_ZIG_TARGET}")
find_program(CYSYNCK_ZIG_EXECUTABLE NAMES zig REQUIRED)
set(CMAKE_C_COMPILER "${CYSYNCK_ZIG_EXECUTABLE}" cc -target "${CYSYNCK_ZIG_TARGET}")
set(CMAKE_CXX_COMPILER "${CYSYNCK_ZIG_EXECUTABLE}" c++ -target "${CYSYNCK_ZIG_TARGET}")
find_program(CMAKE_AR NAMES llvm-ar ar REQUIRED)
find_program(CMAKE_RANLIB NAMES llvm-ranlib ranlib REQUIRED)
set(CMAKE_FIND_ROOT_PATH_MODE_PROGRAM NEVER)
set(CMAKE_FIND_ROOT_PATH_MODE_LIBRARY ONLY)
set(CMAKE_FIND_ROOT_PATH_MODE_INCLUDE ONLY)
set(CMAKE_FIND_ROOT_PATH_MODE_PACKAGE ONLY)
list(APPEND CMAKE_TRY_COMPILE_PLATFORM_VARIABLES
  CYSYNCK_ZIG_EXECUTABLE CYSYNCK_ZIG_TARGET CMAKE_AR CMAKE_RANLIB)
